{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.absoluterevision.com"
        }
      ],
      "destination": "https://absoluterevision.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sign-in",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/login",
      "destination": "/_pages/login.html"
    },
    {
      "source": "/sign-up",
      "destination": "/_pages/sign-up.html"
    },
    {
      "source": "/document-upload",
      "destination": "/_pages/document-upload.html"
    },
    {
      "source": "/track-assignment",
      "destination": "/_pages/track-assignment.html"
    },
    {
      "source": "/dashboard",
      "destination": "/_pages/dashboard.html"
    },
    {
      "source": "/client-submissions",
      "destination": "/_pages/client-submissions.html"
    },
    {
      "source": "/settings",
      "destination": "/_pages/settings.html"
    },
    {
      "source": "/assignments/:id",
      "destination": "/_pages/assignment.html"
    }
  ],
  "headers": [
    {
      "source": "/:page(login|sign-in|sign-up|document-upload|track-assignment|dashboard|client-submissions|settings)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page(login|sign-in|sign-up|document-upload|track-assignment|dashboard|client-submissions|settings)/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assignments/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/_pages/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/submission-retention",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/cron/submission-retention.ts": {
      "maxDuration": 300
    }
  }
}
