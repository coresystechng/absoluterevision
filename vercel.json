{
  "rewrites": [
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/sign-in",
      "destination": "/index.html"
    },
    {
      "source": "/sign-up",
      "destination": "/index.html"
    },
    {
      "source": "/document-upload",
      "destination": "/index.html"
    },
    {
      "source": "/document-upload/",
      "destination": "/index.html"
    },
    {
      "source": "/track-assignment",
      "destination": "/index.html"
    },
    {
      "source": "/track-assignment/",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/assignments/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/track-assignment",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/track-assignment/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
